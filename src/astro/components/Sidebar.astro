---
import { Icon } from "./Icon";
import type { Category } from "../utils/sanity";

interface Props {
  categories: Category[];
  // slug of the category page being viewed
  current?: string;
  // ids of the categories the current post belongs to
  tagged?: string[];
}

const { categories, current, tagged = [] } = Astro.props;
const groups = [
  { label: "Art", items: categories.filter((c) => c.art) },
  { label: "Everything else", items: categories.filter((c) => !c.art) },
].filter((g) => g.items.length);
---

<aside id="sidebar" popover aria-label="Site navigation">
  <a class="sidebar__title" href="/">vera.lgbt</a>
  <nav>
    {
      groups.map((group) => (
        <section>
          <h2 class="sidebar__label">{group.label}</h2>
          <ul>
            {group.items.map((c) => (
              <li>
                <a
                  href={`/category/${c.slug.current}`}
                  aria-current={c.slug.current === current ? "page" : undefined}
                  data-tagged={tagged.includes(c._id) || undefined}
                >
                  <Icon icon={c.icon} />
                  {c.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
</aside>

<style>
  #sidebar {
    /* drawer (mobile) */
    inset: 0 auto 0 0;
    width: min(16rem, 85vw);
    height: 100dvh;
    margin: 0;
    padding: 1.5rem 1rem;
    overflow-y: auto;
    background: var(--background);
    color: var(--foreground);
    border: 0;
    border-right: 1px solid var(--border);
  }
  #sidebar::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  @media (min-width: 768px) {
    #sidebar:not(:popover-open) {
      display: block;
      position: sticky;
      top: 0;
      width: auto;
    }
  }

  .sidebar__title {
    display: block;
    margin: 0 0.5rem 2rem;
    font-weight: 600;
    color: var(--heading);
    text-decoration: none;
  }

  section + section {
    margin-top: 1.5rem;
  }

  .sidebar__label {
    margin: 0 0.5rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  ul a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0 0.25rem 0.25rem 0;
    color: var(--muted-foreground);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  ul a:hover {
    color: var(--heading);
    background: var(--accent);
  }
  ul a[data-tagged] {
    border-left-color: var(--border);
    color: var(--foreground);
  }
  ul a[aria-current="page"] {
    border-left-color: var(--heading);
    color: var(--heading);
    font-weight: 500;
  }
  ul a :global(img) {
    width: 1rem;
    height: 1rem;
    opacity: 0.7;
  }
  :global(.dark) ul a :global(img) {
    filter: invert(1);
  }
</style>
